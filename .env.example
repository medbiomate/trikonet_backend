# Trikonet Backend Environment Configuration

# Server Port and Host
PORT=4173
HOST=0.0.0.0

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=https://trikonet.com,https://www.trikonet.com,https://api.trikonet.com

# MySQL Database Configuration
# In production on Hostinger:
TRIKONET_DB_HOST=localhost
TRIKONET_DB_PORT=3306
TRIKONET_DB_USER=u304645447_user
TRIKONET_DB_PASSWORD=your_database_password
TRIKONET_DB_NAME=u304645447_db

# Local UNIX socket (used in local macOS development if host is not specified)
# TRIKONET_DB_SOCKET=/tmp/mysql.sock
